# Parsing (step 1)
ANTHROPIC_API_KEY="sk-ant-..."

# Google Sheets + Drive (create/share/write survey spreadsheets)
# From your service account's downloaded JSON key file.
GOOGLE_SERVICE_ACCOUNT_EMAIL="xxxx@your-project.iam.gserviceaccount.com"
# Paste the private_key value from the JSON as-is (keep the \n escapes, keep the quotes).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# One fixed spreadsheet that lists every survey ever created (id, name,
# link, created_at) -- can be any existing sheet shared with the service
# account; the "surveys" tab is created automatically if it isn't there.
GOOGLE_INDEX_SHEET_ID="..."

# The Google account every new survey spreadsheet gets created under (via
# domain-wide delegation impersonation -- see lib/googleSheets.ts). Needs
# domain-wide delegation authorized for the service account in your
# Workspace admin console; see README for setup.
USER_GOOGLE_EMAIL="you@example.com"

# Optional but recommended once /api/agent/* is deployed with a public URL --
# shared secret Dograh sends back on every tool call. See dograh/tools-setup.md.
AGENT_TOOLS_SECRET=""

# Optional but recommended once deployed with a public URL -- HTTP Basic
# Auth in front of the upload UI and human-facing API routes (does NOT
# apply to /api/agent/*, which Dograh calls directly -- see middleware.ts).
# If AUTH_PASSWORD is unset, no auth is applied at all.
AUTH_USERNAME="admin"
AUTH_PASSWORD=""
