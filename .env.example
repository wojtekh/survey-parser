# Parsing (step 1)
ANTHROPIC_API_KEY="sk-ant-..."

# Google Sheets + Drive (create/share/write survey spreadsheets)
# From your service account's downloaded JSON key file.
GOOGLE_SERVICE_ACCOUNT_EMAIL="xxxx@your-project.iam.gserviceaccount.com"
# Paste the private_key value from the JSON as-is (keep the \n escapes, keep the quotes).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# One fixed spreadsheet that lists every survey ever created (id, name,
# link, created_at) -- can be any existing sheet shared with the service
# account; the "surveys" tab is created automatically if it isn't there.
GOOGLE_INDEX_SHEET_ID="..."

# The Google account every new survey spreadsheet gets created under (via
# domain-wide delegation impersonation -- see lib/googleSheets.ts). Needs
# domain-wide delegation authorized for the service account in your
# Workspace admin console; see README for setup.
USER_GOOGLE_EMAIL="you@example.com"

# Optional but recommended once /api/agent/* is deployed with a public URL --
# shared secret Dograh sends back on every tool call. See dograh/tools-setup.md.
AGENT_TOOLS_SECRET=""

# Google Calendar (appointment booking). Reuses GOOGLE_SERVICE_ACCOUNT_EMAIL /
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY / USER_GOOGLE_EMAIL above -- the same
# service account, just with the Calendar API enabled and the calendar scope
# added to its domain-wide delegation. See README for setup.
#
# Which calendar to book into. "primary" = USER_GOOGLE_EMAIL's own calendar.
# Set to a specific calendar ID (Calendar settings -> Integrate calendar ->
# Calendar ID) to book into a different, dedicated calendar instead.
GOOGLE_CALENDAR_ID="primary"

# IANA timezone business hours and appointment slots are interpreted in.
BUSINESS_TIME_ZONE="America/New_York"

# Business hours, 24h clock, in BUSINESS_TIME_ZONE.
BUSINESS_HOURS_START="9"
BUSINESS_HOURS_END="17"

# Which days count as business days. 1=Monday ... 7=Sunday. Default Mon-Fri.
BUSINESS_DAYS="1,2,3,4,5"

# Default appointment length in minutes if the agent doesn't specify one.
APPOINTMENT_DURATION_MINUTES="30"

# Prefixed onto the calendar event title, e.g. "Appointment - Jane Smith".
APPOINTMENT_TITLE_PREFIX="Appointment"

# Cal.com (alternative appointment booking backend, alongside Google
# Calendar above -- not a replacement). See lib/calcom.ts header comment
# for full setup. Reuses BUSINESS_TIME_ZONE and APPOINTMENT_DURATION_MINUTES
# from above; does NOT use BUSINESS_HOURS_START/END/BUSINESS_DAYS -- Cal.com
# applies its own Event Type schedule instead.
#
# Settings -> Security -> API Keys in cal.com (or your self-hosted instance).
CAL_API_KEY=""

# The numeric ID of the Event Type appointments get booked against
# (Event Type -> Advanced, or GET /v2/event-types with your API key).
CAL_EVENT_TYPE_ID=""

# Only needed for a self-hosted Cal.com fork (e.g. cal.diy) -- omit for
# hosted cal.com, which defaults to https://api.cal.com.
CAL_API_BASE_URL=""

# Optional but recommended once deployed with a public URL -- HTTP Basic
# Auth in front of the upload UI and human-facing API routes (does NOT
# apply to /api/agent/*, which Dograh calls directly -- see middleware.ts).
# If AUTH_PASSWORD is unset, no auth is applied at all.
AUTH_USERNAME="admin"
AUTH_PASSWORD=""

# Clients + knowledge base (Cognee) -- see client-onboarding-plan.md in the
# Voice AI project folder for the full design.

# Where the embedded SQLite clients database lives (client records, not
# survey data -- that's still on Google Sheets, unaffected). Defaults to
# /app/data/clients.db in the Docker image already; only override for local
# dev outside Docker. MUST be a persistent volume in production -- in
# Coolify, add one in this app's "Storages" tab mounted at /app/data, or
# every client gets wiped on the next redeploy.
CLIENTS_DB_PATH=""

# Your self-hosted Cognee backend's URL (the cognee-backend service added to
# dograh-docker-compose-v3.yaml). Needs to be reachable from wherever
# survey-parser runs -- not the same Docker network as dograh, so this can't
# just be the internal "http://cognee-backend:8000" hostname; give
# cognee-backend its own domain in Coolify (e.g. https://cognee-api.cognexion.com).
COGNEE_API_URL=""

# Domain used to build each client's own Cognee login, e.g.
# "client-<uuid>@cognexion.com". Any real domain works -- Cognee's email
# validator rejects reserved/special-use domains like .local or .test.
COGNEE_CLIENT_EMAIL_DOMAIN="cognexion.com"

# Encrypts each client's Cognee password and every agent's API key before
# they're written to the clients sheet (AES-256-GCM). Generate one with:
#   openssl rand -base64 32
CLIENTS_SECRET_KEY=""
