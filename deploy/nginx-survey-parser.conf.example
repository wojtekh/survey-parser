# NOT needed if deploying via Coolify (see README section 5) -- Coolify runs
# its own proxy (Caddy) and handles the domain/TLS piece automatically once
# you set a domain in the app config. Running this alongside Coolify would
# just fight it for port 443. Kept here only as a fallback for a plain
# Docker + manually-managed nginx host.
#
# Example nginx server block for this app, meant to sit alongside whatever
# server block(s) you already have for Dograh on the same box. Adjust the
# server_name and cert paths to match your actual domain and certbot setup.
#
# Where this goes: usually /etc/nginx/sites-available/survey-parser.conf,
# then `ln -s` it into sites-enabled/ (same as your existing Dograh config
# almost certainly already does), or append it into your existing nginx.conf
# server blocks if you're not using the sites-available/sites-enabled split.

server {
    listen 80;
    server_name survey.yourdomain.com;
    # certbot's --nginx flag will rewrite this block to add the 443/TLS
    # version automatically the first time you run it for this domain --
    # no need to hand-write the SSL directives yourself.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name survey.yourdomain.com;

    # ssl_certificate / ssl_certificate_key get added here by certbot --
    # run: sudo certbot --nginx -d survey.yourdomain.com
    # (reuses your existing certbot install, doesn't need a new one)

    location / {
        proxy_pass http://127.0.0.1:3011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
